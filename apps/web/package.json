{
  "name": "@pss/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "node ../../scripts/generate-feature-catalog.mjs --check && next build --webpack",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:e2e:ci": "playwright test -c playwright.ci.config.ts",
    "test:e2e:experience": "playwright test -c playwright.experience.config.ts",
    "test:e2e:local": "playwright test -c playwright.e2e.config.ts",
    "test:e2e:mvp": "playwright test -c playwright.e2e.config.ts tests/e2e/mvp-demo-path.spec.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "start": "next start -p 3000",
    "lint": "eslint app auth.ts tests playwright.*.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pss/contracts": "workspace:*",
    "@pss/offline": "workspace:*",
    "@pss/ui": "workspace:*",
    "@serwist/next": "9.0.11",
    "@tanstack/react-query": "5.90.2",
    "decimal.js": "10.4.3",
    "lucide-react": "0.468.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.54.2",
    "serwist": "9.0.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@storybook/react": "10.6.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.11",
    "@types/react-dom": "19.2.3",
    "storybook": "10.6.0",
    "vite": "7.3.6"
  }
}
