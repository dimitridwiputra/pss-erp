{
  "name": "@pss/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node ../../scripts/generate-feature-catalog.mjs --check && next build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "start": "next start -p 3000",
    "lint": "eslint app tests playwright.*.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pss/ui": "workspace:*",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@storybook/react": "10.6.0",
    "@types/react": "19.2.11",
    "@types/react-dom": "19.2.3",
    "storybook": "10.6.0",
    "vite": "7.3.6"
  }
}
