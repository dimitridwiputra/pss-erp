{
  "name": "pss-operating-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "dev": "turbo run dev",
    "dev:up": "bash scripts/dev-up.sh",
    "dr:rehearse:local": "bash scripts/rehearse-local-restore.sh",
    "idp:check:local": "node scripts/check-local-idp.mjs",
    "idp:setup:local": "node scripts/setup-local-identity.mjs",
    "storybook": "pnpm --filter @pss/web storybook",
    "test:a11y": "pnpm --filter @pss/web test:a11y",
    "test:visual": "pnpm --filter @pss/web test:visual",
    "test:visual:docker": "bash scripts/test-visual.sh",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts tests apps/api/tests 'domains/**/tests/**/*.ts' eslint.config.mjs && node scripts/check-workspace.mjs && node scripts/check-code-quality.mjs",
    "typecheck": "turbo run typecheck",
    "architecture:check": "node scripts/check-structure.mjs && node scripts/check-architecture.mjs && node scripts/check-api-controller-registration.mjs && node scripts/check-command-fitness.mjs",
    "contracts:check": "node scripts/generate-event-catalog.mjs --check && node scripts/generate-registry-catalog.mjs --check && pnpm --filter @pss/contracts build:code && node packages/contracts/scripts/generate-docs.mjs --check",
    "db:check": "node scripts/check-database.mjs",
    "ui:check": "node scripts/check-ui.mjs",
    "features:check": "node scripts/generate-feature-catalog.mjs --check",
    "secrets:check": "node scripts/check-secrets.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm --filter @pss/web test:e2e:ci",
    "test:e2e:local": "pnpm --filter @pss/web test:e2e:local",
    "gen:domain": "node scripts/gen-domain.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "pg": "8.23.0",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.4"
  }
}
