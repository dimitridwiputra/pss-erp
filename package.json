{
  "name": "pss-operating-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": "24.19.0", "pnpm": "11.19.0" },
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "dev": "turbo run dev",
    "dev:up": "bash scripts/dev-up.sh",
    "storybook": "pnpm --filter @pss/web storybook",
    "test:a11y": "pnpm --filter @pss/web test:a11y",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts tests eslint.config.mjs && node scripts/check-workspace.mjs && node scripts/check-code-quality.mjs",
    "typecheck": "turbo run typecheck",
    "architecture:check": "node scripts/check-structure.mjs && node scripts/check-architecture.mjs",
    "contracts:check": "node scripts/generate-event-catalog.mjs --check && node scripts/generate-registry-catalog.mjs --check && pnpm --filter @pss/contracts build:code && node packages/contracts/scripts/generate-docs.mjs --check",
    "db:check": "node scripts/check-database.mjs",
    "ui:check": "node scripts/check-ui.mjs",
    "features:check": "node scripts/generate-feature-catalog.mjs --check",
    "secrets:check": "node scripts/check-secrets.mjs",
    "test": "vitest run",
    "test:integration": "node scripts/check-scaffold-gate.mjs integration",
    "test:e2e": "node scripts/check-scaffold-gate.mjs e2e",
    "gen:domain": "node scripts/gen-domain.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.4"
  }
}
